INPUT_PARAMETERS
# ============================================================
# ABACUS band structure — nscf along high-symmetry k-path
# task_band: Step 2 of a two-step SCF + NSCF workflow.
#   Step 1: run task_scf.INPUT, save charge density (out_chg=1)
#   Step 2: run this file with init_chg=file and out_band=1
#
# KPT file for band: use K_POINTS Line (see task_band.KPT)
# ============================================================

suffix                  ABACUS
ntype                   1
calculation             nscf

# Pseudopotential and orbital directories
pseudo_dir              ./pseudopotentials/
orbital_dir             ./orbitals/

# Electronic structure
ecutwfc                 50
basis_type              lcao
nspin                   1
nbands                  20

# Start from converged SCF charge density
init_chg                file

# Smearing (needed for numerical stability in nscf)
smearing_method         gauss
smearing_sigma          0.015

# SCF (one-shot, nscf uses fixed charge)
scf_thr                 1e-9
scf_nmax                1

# Output band structure
out_band                1
cal_force               0
