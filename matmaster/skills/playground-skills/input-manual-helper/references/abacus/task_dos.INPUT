INPUT_PARAMETERS
# ============================================================
# ABACUS DOS calculation — nscf with dense k-mesh
# task_dos: Step 2 of a two-step SCF + NSCF workflow.
#   Step 1: run task_scf.INPUT, save charge density (out_chg=1)
#   Step 2: run this file with init_chg=file and out_dos=1
#
# Use a denser k-grid in KPT (8x8x8 or finer) for smooth DOS.
# ============================================================

suffix                  ABACUS
ntype                   1
calculation             nscf

# Pseudopotential and orbital directories
pseudo_dir              ./pseudopotentials/
orbital_dir             ./orbitals/

# Electronic structure
ecutwfc                 50
basis_type              lcao
nspin                   1
nbands                  20

# Start from converged SCF charge density
init_chg                file

# Smearing
smearing_method         gauss
smearing_sigma          0.015

# SCF settings for NSCF (read fixed charge from SCF)
scf_thr                 1e-7
scf_nmax                300

# DOS output settings
out_dos                 1
dos_sigma               0.07
dos_edelta_ev           0.01
dos_nche                100       # Chebyshev expansion order (required for LCAO basis)

# Optional: set energy window (eV relative to Fermi level)
# dos_emin_ev           -10
# dos_emax_ev           10

cal_force               0
