INPUT_PARAMETERS
# ============================================================
# ABACUS ionic relaxation — optimize atomic positions
# task_relax: relax atoms until max force < force_thr
# Use cell-relax variant to also optimize the cell.
# ============================================================

suffix                  ABACUS
ntype                   1
calculation             relax

# Pseudopotential and orbital directories
pseudo_dir              ./pseudopotentials/
orbital_dir             ./orbitals/

# Electronic structure
ecutwfc                 50
basis_type              lcao
nspin                   1
smearing_method         gauss
smearing_sigma          0.015

# SCF convergence
scf_thr                 1e-7
scf_nmax                100
mixing_type             broyden
mixing_beta             0.7
mixing_ndim             8

# Ionic relaxation
cal_force               1
cal_stress              0
force_thr               1e-3
relax_nmax              100
relax_method            bfgs
out_stru                1

# Output
out_chg                 0
