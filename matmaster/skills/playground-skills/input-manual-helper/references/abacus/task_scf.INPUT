INPUT_PARAMETERS
# ============================================================
# ABACUS SCF calculation — Si diamond (LCAO basis)
# task_scf: single-point self-consistent field energy
# Pair with the STRU and KPT files in the same directory.
# ============================================================

suffix                  ABACUS
ntype                   1
calculation             scf

# Pseudopotential and orbital directories
pseudo_dir              ./pseudopotentials/
orbital_dir             ./orbitals/

# Electronic structure
ecutwfc                 50
basis_type              lcao
nspin                   1
smearing_method         gauss
smearing_sigma          0.015

# SCF convergence
scf_thr                 1e-7
scf_nmax                100
mixing_type             broyden
mixing_beta             0.7
mixing_ndim             8

# Forces (not needed for pure SCF; enable for post-processing)
cal_force               0
cal_stress              0

# Output
out_chg                 0
out_band                0
out_dos                 0
