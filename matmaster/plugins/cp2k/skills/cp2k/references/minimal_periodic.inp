! CP2K minimal periodic template. Fallback when user provides no input_file.
! Structure, basis set, and potential are placeholders; prepare_cp2k_job overwrites them.
&GLOBAL
  PROJECT minimal
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 50
      MAX_DIIS 7
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
      ALPHA_BETA_GAMMA 90 90 90
    &END CELL
    &COORD
      X  0.0  0.0  0.0
    &END COORD
    &KIND X
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
