# Remote 节点镜像
# 构建: docker build -f Dockerfile.remote -t remote-node .
FROM registry.dp.tech/dptech/ubuntu:ubuntu24.04-py3.12

ENV DEBIAN_FRONTEND=noninteractive

# 安装 tmux、wget、curl、Open Babel（obabel 命令行及化学格式转换）
RUN apt-get update && apt-get install -y --no-install-recommends \
    tmux \
    wget \
    curl \
    ca-certificates \
    libgfortran5 \
    libquadmath0 \
    openbabel \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖（dpdata 的 mol/sdf 格式依赖 rdkit）
RUN pip install --no-cache-dir \
    ase \
    pymatgen \
    dpdata \
    rdkit \
    numpy \
    matplotlib \
    python-docx \
    requests \
    scikit-learn \
    xgboost \
    lightgbm \
    mendeleev \
    matminer

# -----------------------------
# 安装 VASPKIT（不依赖仓库内 tar 包，在线下载并解压）
# SourceForge 官方链接较慢时，可：
#   1) 使用直连镜像（已默认 jaist）：--build-arg VASPKIT_TARBALL_URL="https://jaist.dl.sourceforge.net/project/vaspkit/Binaries/vaspkit.1.5.1.linux.x64.tar.gz"
#   2) 或自建内网/OSS 放一份 tar.gz，传内网 URL 覆盖
# -----------------------------
ARG VASPKIT_VERSION=1.5.1
# 默认 OSS；解压后自动查找 vaspkit 可执行文件（兼容不同打包方式）
ARG VASPKIT_TARBALL_URL="https://bohrium-agent-test.oss-cn-zhangjiakou.aliyuncs.com/evomaster/calculation/1772540599_vaspkit.1.5.1.linux.x64.tar.gz"
# 解压到 /tmp 仅用于定位目录结构，随后移动到 /opt，避免 /tmp 被节点清理导致 vaspkit 不可用
RUN set -eux \
    && wget -q --show-progress -O /tmp/vaspkit.tar.gz "${VASPKIT_TARBALL_URL}" \
    && mkdir -p /tmp/vaspkit_extract \
    && tar -xzf /tmp/vaspkit.tar.gz -C /tmp/vaspkit_extract \
    && rm -f /tmp/vaspkit.tar.gz \
    && echo "--- extracted contents ---" && ls -la /tmp/vaspkit_extract \
    && VASPKIT_BIN="$(find /tmp/vaspkit_extract -type f -name vaspkit -executable 2>/dev/null | head -1)" \
    && if [ -z "$VASPKIT_BIN" ]; then echo "ERROR: no executable 'vaspkit' found under /tmp/vaspkit_extract"; find /tmp/vaspkit_extract -type f 2>/dev/null || true; exit 1; fi \
    && VASPKIT_DIR="$(dirname "$(dirname "$VASPKIT_BIN")")" \
    && mv "$VASPKIT_DIR" "/opt/vaspkit-${VASPKIT_VERSION}" \
    && rm -rf /tmp/vaspkit_extract \
    && ln -sfn "/opt/vaspkit-${VASPKIT_VERSION}" /opt/vaspkit \
    && ln -sf /opt/vaspkit/bin/vaspkit /usr/local/bin/vaspkit \
    && vaspkit -h || true

ENV PATH="/opt/vaspkit/bin:/usr/local/bin:${PATH}"

WORKDIR /root
