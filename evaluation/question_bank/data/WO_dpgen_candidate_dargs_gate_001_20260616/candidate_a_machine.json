{
  "api_version": "1.0",
  "deepmd_version": "2.2.8",
  "train": {
    "command": "dp train input.json",
    "machine": {
      "batch_type": "Shell",
      "context_type": "local",
      "local_root": "/path/to/work/train"
    },
    "resources": {
      "batch_type": "Shell",
      "number_node": 1,
      "cpu_per_node": 8,
      "gpu_per_node": 1,
      "group_size": 4
    }
  },
  "model_devi": {
    "command": "lmp -in input.lammps",
    "machine": {
      "batch_type": "Shell",
      "context_type": "local",
      "local_root": "/path/to/work/lammps"
    },
    "resources": {
      "batch_type": "Shell",
      "number_node": 1,
      "cpu_per_node": 8,
      "gpu_per_node": 1,
      "group_size": 16
    }
  },
  "fp": {
    "command": "vasp_std",
    "machine": {
      "batch_type": "Shell",
      "context_type": "local",
      "local_root": "/path/to/work/vasp"
    },
    "resources": {
      "batch_type": "Shell",
      "number_node": 1,
      "cpu_per_node": 16,
      "gpu_per_node": 0,
      "group_size": 4
    }
  }
}
