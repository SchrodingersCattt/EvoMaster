# EvoMaster environment variable template (aligned with MatMaster)
# Copy to .env and fill in real values: cp .env.template .env
# Config YAML can reference variables as ${VAR_NAME}; they are substituted at runtime.

# I. LLM Keys (chose one of the following)
# ========== Azure (LLM / embeddings) ==========
# API version for Azure OpenAI endpoints.
AZURE_API_VERSION=
# Base URL of your Azure OpenAI endpoint (e.g. https://your-resource.openai.azure.com/).
AZURE_API_BASE=
# API key for Azure OpenAI.
AZURE_API_KEY=

# ========== LiteLLM Proxy ==========
# Base URL of the LiteLLM proxy.
LITELLM_PROXY_API_BASE=
# API key for the proxy.
LITELLM_PROXY_API_KEY=

# ========== DeepSeek ==========
# API key for DeepSeek.
DEEPSEEK_API_KEY=

# ========== OpenAI / GPT ==========
# OpenAI API key when using OpenAI models directly.
OPENAI_API_KEY=
# Model name (e.g. gpt-4) when using OpenAI-compatible endpoints.
GPT_CHAT_MODEL=
# Base URL for GPT / OpenAI-compatible API.
GPT_BASE_URL=

# ========== Other (optional) ==========
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=


# II. OPIK (Not implemented yet)
# ========== OPIK ==========
# Project name used for OPIK / observability.
OPIK_PROJECT_NAME=


# III. OSS storage (Mandatory for file upload/download)
# ========== OSS (calculation MCP: upload local files to URL) ==========
# Required when passing local structure/files to DPA/calculation tools. run.py loads .env from project root.
# See evomaster/adaptors/calculation/README.md.
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# IV. Bohrium (Mandatory for calculation MCP)
# ========== Bohrium (calculation MCP storage) ==========
# Used by the calculation path adaptor for HTTPS storage with Bohrium auth.
# See evomaster/adaptors/calculation/README.md and _tmp/MatMaster.
# SERVICE_ENV includes [prod, uat, test], the authentication info should be queried from the corresponding bohrium site, e.g. https://www.test.bohrium.com/ for test environment.
SERVICE_ENV= 
BOHRIUM_USER_ID=
BOHRIUM_EMAIL=
BOHRIUM_PASSWORD=
BOHRIUM_PROJECT_ID=
BOHRIUM_ACCESS_KEY=

# V. Memory (Optional, primarily for developers)
# ========== Memory (session memory service for Mat Master) ==========
# HTTP base URL for the memory service (write/retrieve/list). Default: 101.126.90.82:8002
MEMORY_SERVICE_URL=
