{
  "_meta": {
    "description": "POTCAR pseudopotential recommendations per element. Based on VASP wiki 'Choosing pseudopotentials'.",
    "suffixes": {
      "": "standard",
      "_GW": "optimized for GW calculations",
      "_d": "d-electrons treated as valence",
      "_h": "hard (higher cutoff, more accurate)",
      "_pv": "p-electrons in valence (semi-core p)",
      "_s": "soft (fewer electrons, faster, less accurate)",
      "_sv": "s+p semi-core in valence"
    }
  },
  "general_rules": [
    "For structure optimization: standard or _pv is usually sufficient",
    "For magnetic properties: use _pv or _sv (include semicore)",
    "For GW/BSE: ALWAYS use _GW variants",
    "For phonons in large supercells: _s may be acceptable for rough estimates",
    "Soft potentials (_s) should NOT be used with hybrid functionals"
  ],
