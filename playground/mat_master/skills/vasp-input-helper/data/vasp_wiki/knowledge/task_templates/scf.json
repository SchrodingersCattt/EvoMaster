{
  "description": "Single-point self-consistent field (SCF) calculation to obtain ground-state energy and charge density",
  "incar": {
    "conditional": {
      "dft_plus_u": {
        "LASPH": ".TRUE.",
        "LDAU": ".TRUE.",
        "LDAUJ": "per species",
        "LDAUL": "per species",
        "LDAUTYPE": 2,
        "LDAUU": "per species",
        "LMAXMIX": "4 for d, 6 for f"
      },
      "magnetic_system": {
        "ISPIN": 2,
        "MAGMOM": "set initial moments per atom"
      },
      "meta_gga": {
        "LASPH": ".TRUE.",
        "METAGGA": "SCAN or R2SCAN"
      },
      "performance": {
        "KPAR": "divisor of n_kpoints",
        "NCORE": "sqrt(total_cores)"
      },
      "vdw_system": {
        "IVDW": "11 (D3) or 12 (D3-BJ) or 202 (MBD)"
      }
    },
    "recommended": {
      "ALGO": "Fast",
      "LCHARG": true,
      "LREAL": {
        "rule": ".FALSE. for <20 atoms, Auto for >=20 atoms"
      },
      "LWAVE": true,
      "PREC": "Accurate"
    },
    "required": {
      "EDIFF": {
        "note": "tight convergence for production",
        "value": 1e-06
      },
      "ENCUT": {
        "rule": "1.3 * max(ENMAX from POTCAR), or use PREC to set automatically"
      },
      "ISMEAR": {
        "rule": "1 for metals, 0 for semiconductors/insulators"
      },
      "SIGMA": {
        "rule": "0.1-0.2 for metals (ISMEAR=1), 0.01-0.05 for semiconductors (ISMEAR=0)"
      }
    }
  },
  "kpoints": {
    "guideline": "k_i ~ 30/a_i for metals, 20/a_i for insulators (a_i in Angstrom)",
    "note": "Always converge k-mesh for production calculations",
    "rule": "Gamma-centered Monkhorst-Pack grid"
  },
  "poscar": {
    "note": "Must be provided or generated from structure database"
  },
  "potcar": {
    "rule": "Use recommended potentials. _pv or _sv for transition metals. Standard for main group. _GW for GW/BSE workflows."
  },
  "task_type": "scf",
  "use_cases": [
    "total energy",
    "charge density",
    "initial step before band structure or DOS"
  ]
}
