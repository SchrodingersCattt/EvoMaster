{
    "_meta": {
        "description": "VASP INCAR tag constraints: conflicts, dependencies, and conditional requirements",
        "rule_types": {
            "conflict": "these tags/values cannot coexist",
            "forbids_value": "tag A forbids specific value of tag B",
            "recommends": "if tag A is set, tag B should also be set",
            "requires": "if tag A is set, tag B must also be set"
        }
    },
    "conflicts": [
        {
            "condition": {
                "ALGO": "VeryFast",
                "LHFCALC": ".TRUE."
            },
            "fix": "Set ALGO=All or ALGO=Damped",
            "id": "C001",
            "rule": "ALGO=VeryFast is incompatible with hybrid functionals",
            "severity": "error"
        },
        {
            "condition": {
                "IBRION": 0,
                "ISMEAR": -5
            },
            "fix": "Use ISMEAR=0 (Gaussian) or ISMEAR=1 (MP) for MD",
            "id": "C002",
            "rule": "ISMEAR=-5 (tetrahedron) cannot be used for MD or very few k-points",
            "severity": "error"
        },
        {
            "check": "KPOINTS must use Gamma centering",
            "condition": {
                "ISMEAR": -5
            },
            "id": "C003",
            "rule": "ISMEAR=-5 requires Gamma-centered k-mesh",
            "severity": "error"
        },
        {
            "condition": {
                "ISMEAR": ">0",
                "system": "insulator"
            },
            "fix": "Use ISMEAR=0 for insulators/semiconductors",
            "id": "C004",
            "rule": "ISMEAR>0 (Methfessel-Paxton) can give negative occupancies for insulators",
            "severity": "warning"
        },
        {
            "condition": {
                "IBRION": -1,
                "NSW": ">0"
            },
            "fix": "Set NSW=0 for single-point, or set IBRION>=0 for dynamics/relaxation",
            "id": "C005",
            "rule": "IBRION=-1 with NSW>0 recomputes the same structure NSW times",
            "severity": "error"
        },
        {
            "condition": {
                "ICHARG": 11,
                "LHFCALC": ".TRUE."
            },
            "fix": "Use KPOINTS_OPT method for hybrid band structures",
            "id": "C006",
            "rule": "ICHARG=11 does not work with hybrid functionals",
            "severity": "error"
        },
        {
            "condition": {
                "NCORE": "set",
                "NPAR": "set"
            },
            "fix": "Use only NCORE (preferred)",
            "id": "C007",
            "rule": "NPAR and NCORE should not both be set explicitly",
            "severity": "warning"
        }
    ],
    "dependencies": [
        {
            "id": "D001",
            "requires": {
                "ALGO": [
                    "All",
                    "Damped",
                    "Subrot"
                ]
            },
            "rule": "LHFCALC=.TRUE. requires appropriate ALGO",
            "severity": "error",
            "trigger": {
                "LHFCALC": ".TRUE."
            }
        },
        {
            "id": "D002",
            "requires": [
                "LDAUTYPE",
                "LDAUL",
                "LDAUU",
                "LDAUJ"
            ],
            "rule": "LDAU=.TRUE. requires LDAUTYPE, LDAUL, LDAUU, LDAUJ",
            "severity": "error",
            "trigger": {
                "LDAU": ".TRUE."
            }
        },
        {
            "id": "D003",
            "requires": {
                "LMAXMIX": 4
            },
            "rule": "LDAU with d-electrons requires LMAXMIX=4",
            "severity": "warning",
            "trigger": {
                "LDAU": ".TRUE.",
                "LDAUL_contains": 2
            }
        },
        {
            "id": "D004",
            "requires": {
                "LMAXMIX": 6
            },
            "rule": "LDAU with f-electrons requires LMAXMIX=6",
            "severity": "warning",
            "trigger": {
                "LDAU": ".TRUE.",
                "LDAUL_contains": 3
            }
        },
        {
            "id": "D005",
            "requires": {
                "LASPH": ".TRUE."
            },
            "rule": "Meta-GGA requires LASPH=.TRUE.",
            "severity": "error",
            "trigger": {
                "METAGGA": "any"
            }
        },
        {
            "id": "D006",
            "implies": {
                "LNONCOLLINEAR": ".TRUE."
            },
            "note": "MAGMOM needs 3 components per atom",
            "rule": "LSORBIT automatically sets LNONCOLLINEAR",
            "severity": "info",
            "trigger": {
                "LSORBIT": ".TRUE."
            }
        },
        {
            "id": "D007",
            "recommends": {
                "NBANDS": "increase to 2-3x default"
            },
            "rule": "LOPTICS requires sufficient empty bands",
            "severity": "warning",
            "trigger": {
                "LOPTICS": ".TRUE."
            }
        },
        {
            "id": "D008",
            "requires_file": "CHGCAR",
            "rule": "Band structure non-SCF requires ICHARG=11 and CHGCAR",
            "severity": "error",
            "trigger": {
                "ICHARG": 11
            }
        },
        {
            "id": "D009",
            "note": "Number of MPI processes must be divisible by IMAGES",
            "requires": {
                "IBRION": [
                    1,
                    2,
                    3
                ]
            },
            "rule": "NEB requires IMAGES>0",
            "severity": "error",
            "trigger": {
                "IMAGES": ">0"
            }
        },
        {
            "id": "D010",
            "requires": [
                "LANGEVIN_GAMMA"
            ],
            "rule": "Langevin thermostat requires LANGEVIN_GAMMA",
            "severity": "error",
            "trigger": {
                "MDALGO": 3
            }
        },
        {
            "id": "D011",
            "recommends": [
                "MAGMOM"
            ],
            "rule": "ISPIN=2 should have MAGMOM set",
            "severity": "warning",
            "trigger": {
                "ISPIN": 2
            }
        }
    ],
    "pulay_stress_check": {
        "condition": {
            "ISIF": ">=3"
        },
        "id": "P001",
        "requires": {
            "ENCUT": ">= 1.3 * max(ENMAX from POTCAR)",
            "PREC": "Accurate"
        },
        "rule": "Volume relaxation (ISIF>=3) needs high ENCUT to avoid Pulay stress",
        "severity": "warning"
    },
    "smearing_guidelines": {
        "dos_accurate_energy": {
            "ISMEAR": [
                -5
            ],
            "note": "tetrahedron with Blöchl, Gamma-centered mesh only"
        },
        "metal": {
            "ISMEAR": [
                1,
                2
            ],
            "SIGMA": "0.1-0.2",
            "check": "entropy T*S in OUTCAR should be < 1 meV/atom"
        },
        "molecular_dynamics": {
            "ISMEAR": [
                0,
                1
            ],
            "forbid": [
                -5
            ],
            "note": "never tetrahedron for MD"
        },
        "semiconductor_insulator": {
            "ISMEAR": [
                0
            ],
            "SIGMA": "0.01-0.05"
        }
    }
}
