  "info": {
    "description": "MatMaster-Evo 后端服务",
    "title": "MatMaster-Evo",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "根端点",
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root",
        "tags": [
          "系统状态"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "健康检查端点",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/chat/sessions/list": {
      "get": {
        "description": "按当前登录用户查询会话列表，支持分页和按 `project_id` 过滤。 当传入 `project_id` 时，仅返回该项目下的会话。",
        "operationId": "listChatSessions",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "project_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Project Id"
            }
          },
          {
            "description": "当前登录用户 ID，由上游网关注入。",
            "in": "header",
            "name": "X-User-Id",
            "required": true,
            "schema": {
              "description": "当前登录用户 ID，由上游网关注入。",
              "examples": [
                "test-user-123"
              ],
              "title": "X-User-Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionListApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApiResponse"
                }
              }
            },
            "description": "缺少或无效的 X-User-Id"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "查询会话列表",
        "tags": [
          "Chat Sessions"
        ]
      }
    },
    "/api/v1/chat/sessions/run_status": {
      "get": {
        "description": "返回当前系统中执行中的任务数和排队中的任务数，无需认证。",
        "operationId": "getChatSessionRunStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatusApiResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "查询运行队列状态",
        "tags": [
          "Chat Sessions"
        ]
      }
    },
    "/api/v1/chat/sessions/{session_id}": {
      "delete": {
        "description": "仅会话所有者可删除；关联聊天事件会随会话级联删除。",
        "operationId": "deleteChatSession",
        "parameters": [
          {
            "description": "会话 ID",
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "description": "会话 ID",
              "examples": [
                "session-001"
              ],
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "description": "当前登录用户 ID，由上游网关注入。",
            "in": "header",
            "name": "X-User-Id",
            "required": true,
            "schema": {
              "description": "当前登录用户 ID，由上游网关注入。",
              "examples": [
                "test-user-123"
              ],
              "title": "X-User-Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApiResponse"
                }
              }
            },
            "description": "缺少或无效的 X-User-Id"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApiResponse"
                }
              }
            },
            "description": "资源不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "删除会话",
        "tags": [
          "Chat Sessions"
        ]
      }
    },
    "/api/v1/chat/sessions/{session_id}/confirmation_reply": {
      "post": {
        "description": "当会话流返回 `confirmation_request` 时，调用本接口提交用户回复，Agent 会继续执行。",
        "operationId": "replyChatSessionConfirmation",
        "parameters": [
          {
            "description": "会话 ID",
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "description": "会话 ID",
              "examples": [
                "session-001"
              ],
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "description": "当前登录用户 ID；未登录或匿名访问时可不传。",
            "in": "header",
            "name": "X-User-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "当前登录用户 ID；未登录或匿名访问时可不传。",
              "examples": [
                "test-user-123"
              ],
              "title": "X-User-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatPlannerReplyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApiResponse"
                }
              }
            },
            "description": "无权限访问该资源"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApiResponse"
                }
              }
            },
            "description": "资源状态冲突"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "提交确认回复",
        "tags": [
          "Chat Sessions"
        ]
      }
    },
    "/api/v1/chat/sessions/{session_id}/share": {
      "get": {
        "description": "查看会话是否已开启分享。已分享时任何人可查看；未分享时需为会话所有者。",
        "operationId": "getChatSessionShareStatus",
        "parameters": [
          {
            "description": "会话 ID",
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "description": "会话 ID",
              "examples": [
                "session-001"
              ],
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "description": "当前登录用户 ID；未登录或匿名访问时可不传。",
            "in": "header",
            "name": "X-User-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "当前登录用户 ID；未登录或匿名访问时可不传。",
              "examples": [
                "test-user-123"
              ],
              "title": "X-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareStatusApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApiResponse"
                }
              }
            },
            "description": "无权限访问该资源"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "查询会话分享状态",
        "tags": [
          "Chat Sessions"
        ]
      },
      "put": {
        "description": "仅会话所有者可设置。开启分享后，其他人可在未登录场景下访问该会话的分享能力。",
        "operationId": "setChatSessionShareStatus",
        "parameters": [
          {
            "description": "会话 ID",
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "description": "会话 ID",
              "examples": [
                "session-001"
              ],
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "description": "当前登录用户 ID，由上游网关注入。",
            "in": "header",
            "name": "X-User-Id",
            "required": true,
            "schema": {
              "description": "当前登录用户 ID，由上游网关注入。",
              "examples": [
                "test-user-123"
              ],
              "title": "X-User-Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareSetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
