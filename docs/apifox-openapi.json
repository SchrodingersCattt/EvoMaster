    "/api/v1/debug/memory": {
      "get": {
        "description": "进程内存 RSS：仅读 /proc/self/status，几乎不占内存，适合 2G 等小规格。\n用法：先 GET ?baseline=1，再执行几轮对话，再 GET ?diff=1 看 rss_delta_mb 是否持续增大。",
        "operationId": "get_memory_api_v1_debug_memory_get",
        "parameters": [
          {
            "description": "设为 True 时把当前进程 RSS 存为基线",
            "in": "query",
            "name": "baseline",
            "required": false,
            "schema": {
              "default": false,
              "description": "设为 True 时把当前进程 RSS 存为基线",
              "title": "Baseline",
              "type": "boolean"
            }
          },
          {
            "description": "设为 True 时返回当前 RSS 与基线差值（需先设 baseline）",
            "in": "query",
            "name": "diff",
            "required": false,
            "schema": {
              "default": false,
              "description": "设为 True 时返回当前 RSS 与基线差值（需先设 baseline）",
              "title": "Diff",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Memory Api V1 Debug Memory Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Memory",
        "tags": [
          "debug"
        ]
      }
    },
    "/api/v1/debug/tracemalloc": {
      "get": {
        "description": "tracemalloc 当前快照（按 lineno 的 top 分配）。仅一次 take_snapshot，无 diff。\n若要看进程内存是否随对话增长，请用 GET /api/v1/debug/memory（?baseline=1 与 ?diff=1）。",
        "operationId": "get_tracemalloc_api_v1_debug_tracemalloc_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Tracemalloc Api V1 Debug Tracemalloc Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Tracemalloc",
        "tags": [
          "debug"
        ]
      }
    },
    "/api/v1/debug/tracemalloc/diff-from-disk": {
      "get": {
        "description": "从已存在的 dump 文件做 diff，直接返回「哪里分配」的 top 列表。\n在 Pod 内用法：先调两次 dump?tag=baseline 和 dump?tag=current，再调本接口即可，无需拷文件或跑脚本。\n若内存紧张可能 OOM，可改把两个 .dump 拷到本机用 scripts/analyze_tracemalloc_diff.py。",
        "operationId": "tracemalloc_diff_from_disk_api_v1_debug_tracemalloc_diff_from_disk_get",
        "parameters": [
          {
            "description": "基线 dump 的 tag，对应文件 {tag}.dump",
            "in": "query",
            "name": "baseline_tag",
            "required": false,
            "schema": {
              "default": "baseline",
              "description": "基线 dump 的 tag，对应文件 {tag}.dump",
              "title": "Baseline Tag",
              "type": "string"
            }
          },
          {
            "description": "当前 dump 的 tag",
            "in": "query",
            "name": "current_tag",
            "required": false,
            "schema": {
              "default": "current",
              "description": "当前 dump 的 tag",
              "title": "Current Tag",
              "type": "string"
            }
          },
          {
            "description": "返回前 N 条",
            "in": "query",
            "name": "top",
            "required": false,
            "schema": {
              "default": 15,
              "description": "返回前 N 条",
              "maximum": 50,
              "minimum": 1,
              "title": "Top",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Tracemalloc Diff From Disk Api V1 Debug Tracemalloc Diff From Disk Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Tracemalloc Diff From Disk",
        "tags": [
          "debug"
        ]
      }
    },
    "/api/v1/debug/tracemalloc/dump": {
      "get": {
        "description": "拍当前 tracemalloc 快照并直接以附件形式返回，不写入服务端磁盘，减轻 2G 内存/磁盘压力。\n用法：GET ?tag=baseline 下载 baseline.dump，跑几轮对话，GET ?tag=current 下载 current.dump，\n在本机执行 scripts/analyze_tracemalloc_diff.py baseline.dump current.dump 看「哪里分配」。",
        "operationId": "tracemalloc_dump_api_v1_debug_tracemalloc_dump_get",
        "parameters": [
          {
            "description": "快照标签，如 baseline / current，响应为附件 {tag}.dump",
            "in": "query",
            "name": "tag",
            "required": true,
            "schema": {
              "description": "快照标签，如 baseline / current，响应为附件 {tag}.dump",
              "title": "Tag",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Tracemalloc Dump",
        "tags": [
          "debug"
        ]
      }
    }
  }
