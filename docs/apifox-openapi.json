    "/api/v1/chat/sessions/{session_id}/stream": {
      "post": {
        "description": "统一 SSE 流接口。 `content` 为空或不传 body 时，仅订阅该会话的历史和心跳； `content` 非空时，发送消息并返回本次运行的 SSE 流。",
        "operationId": "streamChatSession",
        "parameters": [
          {
            "description": "会话 ID",
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "description": "会话 ID",
              "examples": [
                "session-001"
              ],
              "title": "Session Id",
